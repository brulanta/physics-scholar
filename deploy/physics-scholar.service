[Unit]
Description=PhysicsScholar backend (FastAPI/uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/physics-scholar
ExecStart=/home/ubuntu/apps/physics-scholar/.venv/bin/uvicorn src.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
